# ─────────────────────────────────────────────────────────────────────
# backend/.env — copier en .env et remplir. Jamais commité (.gitignore).
# Même méthode que Tangent : lu par os.getenv dans le module qui en a besoin.
# ─────────────────────────────────────────────────────────────────────
APP_ENV=dev

# ── Base ──
POSTGRES_PASSWORD=caseduo_dev
# DATABASE_URL est fourni par docker compose ; hors Docker :
# DATABASE_URL=postgresql+asyncpg://caseduo:caseduo_dev@localhost:5433/caseduo

# ── Auth (fastapi-users, cookie JWT) ──
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_ME_WITH_SECRETS_TOKEN_URLSAFE
COOKIE_NAME=caseduo_auth
COOKIE_LIFETIME_SECONDS=604800   # 7 jours
COOKIE_SECURE=false              # true en prod (forcé par docker-compose.prod.yml)
SESSION_RENEW_AFTER_SECONDS=86400

# Le compte dont les faiblesses pilotent la génération du jour (DEVIATIONS D9).
# Vide = le premier superuser.
OWNER_EMAIL=

# ── Claude (ADR-015 de Tangent) ──
ANTHROPIC_API_KEY=
# Un seul modèle pour la génération et la notation. claude-sonnet-4-5 est retiré
# le 2026-11-30 : voir docs/DEVIATIONS.md D1 (proposition : claude-sonnet-5-5).
CASEDUO_MODEL=claude-sonnet-4-5
# Plafond global journalier, toutes dépenses Claude confondues (USD).
LLM_DAILY_CAP_USD=1.0
# Recherches web max par case généré (0 = aucune). Voir DEVIATIONS D2.
GENERATION_WEB_SEARCH_MAX_USES=3

# ── Qui écrit les exercices (DEVIATIONS D15) ──
# claude_code / auto : le serveur les écrit lui-même avec Claude Code sur ton abonnement
#   (CLAUDE_CODE_OAUTH_TOKEN ci-dessous), recherche web comprise : demain à 03:00, et
#   aujourd'hui au démarrage s'il manque quelque chose. auto passe à l'API sans jeton.
# api : le batch Message Batches de 03:00 (payant, −50 %).
# Le secours de 05:30 complète ce qui manque ; sans jeton ni clé, c'est le pack écrit à la main.
GENERATION_PROVIDER=claude_code
# Modèle et effort de la génération (vides : CLAUDE_CODE_MODEL, effort high).
CLAUDE_CODE_GENERATION_MODEL=
CLAUDE_CODE_GENERATION_EFFORT=high
# Exercices écrits en même temps, au plus (la notation garde ses propres places).
CLAUDE_CODE_GENERATION_PARALLEL=2

# ── Qui note les réponses (DEVIATIONS D14) ──
# auto : Claude Code sur ton abonnement si CLAUDE_CODE_OAUTH_TOKEN est rempli, sinon l'API
#   si ANTHROPIC_API_KEY l'est. claude_code / api : l'un ou l'autre, sans repli.
GRADING_PROVIDER=auto
# Jeton longue durée de `claude setup-token` (abonnement Claude). Secret GitHub du même
# nom : la CD l'écrit ici.
CLAUDE_CODE_OAUTH_TOKEN=
# Un alias suit le modèle courant (pas de date de retrait à surveiller).
CLAUDE_CODE_MODEL=sonnet
# low : notes en ~5 s, correction complète en ~15 s. medium ou high : plus lent, plus fouillé.
CLAUDE_CODE_EFFORT=low
# Réponses notées en même temps, au plus.
CLAUDE_CODE_MAX_PARALLEL=3

# ── Jobs planifiés (APScheduler dans le process) ──
JOBS_TIMEZONE=Asia/Singapore
SCHEDULER_ENABLED=true

# ── Sign in with Apple (natif seulement : seul le bundle sert d'audience) ──
APPLE_BUNDLE_ID=uk.riskybusinesses.caseduo

# ── Push APNs (DEVIATIONS D5) ──
# Team ID et Key ID ne sont pas secrets. Clé « APNs » (Sandbox & Production, toute l'équipe).
APNS_TEAM_ID=FLCJTJCQM9
APNS_KEY_ID=A47C7KD857
# Le seul secret : le .p8 en base64 (secret GitHub APNS_PRIVATE_KEY_B64, écrit par la CD).
# base64 -w0 AuthKey_A47C7KD857.p8
APNS_PRIVATE_KEY_B64=
APNS_BUNDLE_ID=uk.riskybusinesses.caseduo

# ─────────────────────────────────────────────────────────────────────
# backend/.env — copier en .env et remplir. Jamais commité (.gitignore).
# Même méthode que Tangent : lu par os.getenv dans le module qui en a besoin.
# ─────────────────────────────────────────────────────────────────────
APP_ENV=dev

# ── Base ──
POSTGRES_PASSWORD=caseduo_dev
# DATABASE_URL est fourni par docker compose ; hors Docker :
# DATABASE_URL=postgresql+asyncpg://caseduo:caseduo_dev@localhost:5433/caseduo

# ── Auth (fastapi-users, cookie JWT) ──
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_ME_WITH_SECRETS_TOKEN_URLSAFE
COOKIE_NAME=caseduo_auth
COOKIE_LIFETIME_SECONDS=604800   # 7 jours
COOKIE_SECURE=false              # true en prod (forcé par docker-compose.prod.yml)
SESSION_RENEW_AFTER_SECONDS=86400

# Le compte dont les faiblesses pilotent la génération du jour (DEVIATIONS D9).
# Vide = le premier superuser.
OWNER_EMAIL=

# ── Claude (ADR-015 de Tangent) ──
ANTHROPIC_API_KEY=
# Un seul modèle pour la génération et la notation. claude-sonnet-4-5 est retiré
# le 2026-11-30 : voir docs/DEVIATIONS.md D1 (proposition : claude-sonnet-5-5).
CASEDUO_MODEL=claude-sonnet-4-5
# Plafond global journalier, toutes dépenses Claude confondues (USD).
LLM_DAILY_CAP_USD=1.0
# Recherches web max par case généré (0 = aucune). Voir DEVIATIONS D2.
GENERATION_WEB_SEARCH_MAX_USES=3

# ── Jobs planifiés (APScheduler dans le process) ──
JOBS_TIMEZONE=Asia/Singapore
SCHEDULER_ENABLED=true

# ── Sign in with Apple (natif seulement : seul le bundle sert d'audience) ──
APPLE_BUNDLE_ID=uk.riskybusinesses.caseduo

# ── Push APNs (DEVIATIONS D5) ──
# Clé .p8 « Apple Push Notifications service » du compte développeur :
# base64 -w0 AuthKey_XXXXXXXXXX.p8
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_B64=
APNS_BUNDLE_ID=uk.riskybusinesses.caseduo
